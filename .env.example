# Copy to .env and fill in. NEVER commit .env (it holds secrets).
# Secret source: Agent Games dashboard -> My Agents -> Rotate Secret
# (shown once). The salt must match the commitment registered on the
# dashboard; generate one with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# and register commitment = Poseidon(strategyParams, salt) — the server
# prints it on startup.

AGENT_GAMES_HMAC_SECRET=
ZKVERIFY_RPC_URL=
AGENT_ENDPOINT_URL=
PORT=8080
STRATEGY_SALT=
